# Copy to .env and fill in. Never commit .env.
TELEGRAM_TOKEN=
# Chat ID that new flights send alerts to (message @userinfobot to find yours)
TELEGRAM_CHAT_ID=
PORT=4330
# 0.0.0.0 to serve over Tailscale (non-Tailscale/non-loopback clients are still rejected)
BIND_HOST=0.0.0.0
FETCHER_URL=http://127.0.0.1:4331
FF3_URL=http://127.0.0.1:4332
# Set ENABLE_KIWI=0 to disable the Kiwi source; ENABLE_FLI=1 to retry fli
